{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runemoire-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "account_id": "fb77e1546b266bb431061f99461d69df",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "runemoire.com", "custom_domain": true },
    { "pattern": "www.runemoire.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runemoire-site",
      "database_id": "af5fa93d-c911-4fe5-96ce-bd2b75f962ce",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "NOTIFY_LIMIT", "namespace_id": "4711", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
